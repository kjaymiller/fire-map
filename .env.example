# NASA FIRMS API key: https://firms.modaps.eosdis.nasa.gov/api/
NASA_FIRMS_API_KEY=

# How often the scheduler reloads data, and how long the Valkey cache
# entry lives before it expires (kept in sync so the cache goes stale
# right around the next scheduled reload).
UPDATE_INTERVAL_SECONDS=900

# Postgres (history store). Defaults below match docker-compose.yaml.
POSTGRES_DB=firemap
POSTGRES_USER=firemap
POSTGRES_PASSWORD=firemap
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Valkey (current-snapshot cache).
VALKEY_HOST=localhost
VALKEY_PORT=6379

# Notifier (src/notifier.py): sends queued location alerts via Apprise
# (https://apprise.kjaymiller.dev/) to each subscriber's registered
# channels (see /channels in web/app.py). Only email and discord channels
# are actually wired to delivery today -- see
# src/db/channels.py:DELIVERABLE_CHANNEL_TYPES.
#
# Email routes through one shared Mailgun account (https://mailgun.com) --
# NOTIFY_MAILGUN_DOMAIN is your verified sending domain, NOTIFY_MAILGUN_API_KEY
# is the account's private API key, and NOTIFY_MAILGUN_FROM_USER is the local
# part of the from-address (mails go out as <from_user>@<domain>; defaults to
# "alerts"). NOTIFY_MAILGUN_REGION is "eu" if your domain is EU-hosted,
# otherwise leave unset for the US default. Discord channels don't need any
# of this -- each account's channel address is the webhook URL Discord gave
# them. Manage these as secrets with fnox rather than committing real values here.
# NOTIFY_MAILGUN_DOMAIN=
# NOTIFY_MAILGUN_API_KEY=
# NOTIFY_MAILGUN_FROM_USER=alerts
# NOTIFY_MAILGUN_REGION=

# Signs the login session cookie (see web/app.py). Leave unset and the app
# generates a random one at startup -- fine for a single dev run, but every
# restart invalidates existing logins. Set this to keep sessions across
# restarts. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# SESSION_SECRET_KEY=

# OpenTelemetry. Every route and every Postgres/Valkey command gets its own
# span, and every log line gets exported too (see src/otel.py). Leave
# OTEL_EXPORTER_OTLP_ENDPOINT unset to just print spans/logs to stdout.
# `docker compose up` (mise run up) already points web/scheduler at the
# bundled otel-collector container (http://otel-collector:4318), which
# forwards traces on to Jaeger (browse them at http://localhost:16686) and
# prints logs for now -- see otel-collector-config.yaml to point either
# pipeline somewhere durable. Running a service outside compose (e.g. plain
# `uv run`)? Point this at http://localhost:4318 instead, or at a real OTLP
# endpoint (Aiven-hosted collector, Grafana Cloud, Honeycomb, ...).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
